# ===== 服务 =====
PORT=3000
HOST=0.0.0.0
# 交班时间，纸上只写 10.18~10.19 时自动补全为 10.18 6:00 - 10.19 6:00
SHIFT_START=6:00

# 访问码：设置后，识别前需要输入，防止网站被外人刷 API 额度（强烈建议设置）
ACCESS_CODE=
# 后台密码：设置后可在 http://服务器:端口/admin 在线修改 AI 配置
ADMIN_PASSWORD=

# ===== AI 接口（兼容 OpenAI Chat Completions 格式，需支持图片输入）=====
# 后台保存过的配置会覆盖这里的值
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o
AI_TEMPERATURE=0
